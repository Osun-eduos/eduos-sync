# Same database as eduos-api. The ?schema= parameter is accepted.
DATABASE_URL=postgresql://eduos:eduos@localhost:5432/eduos?schema=public
# eduos-api's public key (ES256). It can check tokens but not create them. Paste the PEM with \n for line breaks,
# or base64-encode it. eduos-api's `npm run keys` prints both keys.
JWT_PUBLIC_KEY=
# Where the sync service reaches eduos-api (an internal address in production).
API_URL=http://localhost:3000
PORT=4000
# How many days of recent registers phones receive.
SNAPSHOT_REGISTER_DAYS=14
